# Same public HTTPS URL must be used when building and running.
NEXT_PUBLIC_SITE_URL=https://okna-berta.ru
# Generate each secret independently. Never commit the real .env.
PAYLOAD_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
CMS_ADMIN_EMAIL=admin@example.com
CMS_ADMIN_PASSWORD=CHANGE_ME_GENERATE_A_UNIQUE_PASSWORD
DATABASE_URL=file:/app/storage/berta.db
CMS_MEDIA_DIR=/app/storage/media
# CRM stays disabled until configured in CMS and verified separately.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
CRM_API_URL=
CRM_API_TOKEN=
